# ---------------------------------------------------------------------------
# AI Code Reviewer — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# REQUIRED. Server-side Groq API key. Lives only here / in the container env;
# it is never sent to the browser. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Runtime mode. "production" enables the public-demo hardening:
# rate limiting, snippet-only input (no file uploads), strict size caps,
# hidden API-key UI, /docs disabled. Defaults to "development" if unset.
ENVIRONMENT=production

# Port the app listens on inside the container (mapped to 127.0.0.1:8082).
PORT=8082

# ---- Rate limiting (production only) — "Balanced" profile ----
# Per real client IP (resolved from CF-Connecting-IP behind Cloudflare):
RL_PER_MIN=8          # analyses per minute per IP
RL_PER_DAY=40         # analyses per day per IP
# Across ALL IPs — a hard daily ceiling protecting your Groq quota:
RL_GLOBAL_PER_DAY=300 # analyses per day, global

# ---- Input size caps ----
MAX_CODE_CHARS=51200      # max characters of source per analysis (50 KB)
MAX_CONTENT_LENGTH=262144 # max request body in bytes (256 KB, prod)
